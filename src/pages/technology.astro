---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { loadPages } from '../lib/content';

const { technology } = loadPages();
---

<Base title={technology.title} description={technology.intro[0]} section="technology">
  <PageHero title={technology.heading} />
  <div class="mx-auto grid w-[90%] gap-10 py-14 text-[15.8px] leading-[1.52] min-[981px]:px-[240px] min-[981px]:py-20">
    <h2 class="text-[36px] leading-tight text-[#333] min-[981px]:text-[48px]">
      {technology.subheading}
    </h2>
    <p class="label -mt-6 text-[24px] leading-snug text-accent">{technology.tagline}</p>
    {technology.intro.map((paragraph) => <p>{paragraph}</p>)}
    <section class="grid gap-4">
      <h2 class="label text-[24px] text-accent">{technology.howItWorks.heading}</h2>
      <ol class="grid gap-4">
        {
          technology.howItWorks.steps.map((step) => (
            <li>
              <p class="label text-black">{step.label}</p>
              <p>{step.text}</p>
            </li>
          ))
        }
      </ol>
      <p>{technology.howItWorks.outro}</p>
    </section>
    {
      technology.sections.map((section) => (
        <section class="mt-2 grid gap-4">
          <h2 class="label text-[24px] text-accent">{section.heading}</h2>
          {section.body.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </section>
      ))
    }
  </div>
</Base>
