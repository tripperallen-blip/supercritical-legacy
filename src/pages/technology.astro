---
import Base from '../layouts/Base.astro';
import { loadPages } from '../lib/content';

const { technology } = loadPages();
const intro = technology.sections[0]?.paragraphs[0];
---

<Base title={technology.title} description={intro} section="technology">
  <div class="mx-auto grid max-w-3xl gap-12 px-4 py-12">
    <h1 class="text-4xl">{technology.title}</h1>
    {
      technology.sections.map((section) => (
        <section class="grid gap-4">
          <h2 class="text-2xl">{section.heading}</h2>
          {section.subheading ? <p class="text-lg">{section.subheading}</p> : null}
          {section.steps.length > 0 ? (
            <ol class="grid gap-4">
              {section.steps.map((step) => (
                <li>
                  <p class="font-medium">{step.label}</p>
                  <p>{step.body}</p>
                </li>
              ))}
            </ol>
          ) : null}
          {section.paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </section>
      ))
    }
  </div>
</Base>
