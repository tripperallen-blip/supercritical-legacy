---
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import { loadPages } from '../lib/content';

const { home, site } = loadPages();
---

<Base title={home.title} description={home.paragraphs[0]} section="home">
  <section class="border-b border-neutral-200 bg-neutral-50">
    <div class="mx-auto grid max-w-5xl gap-6 px-4 py-16">
      <p class="text-sm uppercase tracking-wide">{site.tagline}</p>
      <h1 class="max-w-3xl text-4xl leading-tight md:text-5xl">
        {home.heroLines.map((line) => <span class="block">{line}</span>)}
      </h1>
      <div class="flex flex-wrap gap-3">
        {
          home.actions.map((action) => (
            <a href={action.href} class="border border-neutral-900 px-4 py-2 text-sm">
              {action.label}
            </a>
          ))
        }
      </div>
    </div>
  </section>
  <section class="mx-auto grid max-w-3xl gap-4 px-4 py-12">
    {home.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
  </section>
  <section class="mx-auto grid max-w-xl gap-4 px-4 pb-16">
    <h2 class="text-xl">Contact</h2>
    <p>{site.formIntro}</p>
    <ContactForm idPrefix="home" />
  </section>
</Base>
