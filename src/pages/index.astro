---
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import { loadPages } from '../lib/content';

const { home, site } = loadPages();
---

<Base title={site.defaultTitle} description={home.body[0]} section="home">
  <section class="relative isolate flex min-h-[85vh] items-center overflow-hidden bg-neutral-950 text-white">
    <video
      class="absolute inset-0 -z-10 h-full w-full object-cover"
      src={home.heroVideo}
      autoplay
      muted
      loop
      playsinline
      aria-hidden="true"
    ></video>
    <img
      src="/assets/extra/video-overlay3.png"
      alt=""
      class="pointer-events-none absolute inset-0 -z-10 h-full w-full object-cover"
    />
    <div class="mx-auto grid w-full max-w-5xl gap-6 px-4 py-16">
      <img src={home.heroLogo} alt="" class="h-14 w-auto md:h-20" />
      <h1 class="max-w-3xl text-4xl leading-tight md:text-5xl">{home.heading}</h1>
      <div class="flex flex-wrap gap-3">
        {
          home.heroButtons.map((action) => (
            <a href={action.href} class="border border-white px-4 py-2 text-sm">
              {action.label}
            </a>
          ))
        }
      </div>
    </div>
  </section>
  <section class="mx-auto grid max-w-3xl gap-4 px-4 py-12">
    {home.body.map((paragraph) => <p>{paragraph}</p>)}
    <div class="flex flex-wrap gap-3 pt-2">
      {
        home.bodyButtons.map((action) => (
          <a href={action.href} class="border border-neutral-900 px-4 py-2 text-sm">
            {action.label}
          </a>
        ))
      }
    </div>
  </section>
  <section class="mx-auto grid max-w-xl gap-4 px-4 pb-16">
    <h2 class="text-xl">{site.contactModal.heading}</h2>
    <p>{site.contactModal.intro}</p>
    <ContactForm idPrefix="home" />
  </section>
</Base>
