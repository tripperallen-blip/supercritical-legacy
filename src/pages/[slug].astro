---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { formatDate, subtitlesOf } from '../lib/content';

export async function getStaticPaths() {
  const posts = await getCollection('news');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const subtitles = subtitlesOf(post.data);
---

<Base title={post.data.title} description={subtitles[0] ?? post.data.dateline} section="news">
  <article class="mx-auto grid max-w-3xl gap-4 px-4 py-12">
    <p class="text-sm uppercase tracking-wide">Press release</p>
    <h1 class="text-3xl leading-tight">{post.data.title}</h1>
    {subtitles.map((subtitle) => <p class="text-lg">{subtitle}</p>)}
    <p class="text-sm text-neutral-600">
      <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      <span> · {post.data.dateline}</span>
    </p>
    {
      post.data.image && (
        <img src={post.data.image} alt="" class="w-full" />
      )
    }
    <div class="rich-text">
      <Content />
    </div>
    <p>
      <a href="/news/" class="text-sm underline">Back to news</a>
    </p>
  </article>
</Base>
