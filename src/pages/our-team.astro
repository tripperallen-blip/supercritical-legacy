---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { bioParagraphs, loadPages, loadTeam, type TeamMember } from '../lib/content';

const { team: teamPage } = loadPages();
const team = loadTeam();
const groups = (['officers', 'technical', 'advisory'] as const).map((id) => ({
  id,
  heading: teamPage.groups[id],
}));
---

<Base title={teamPage.title} section="team">
  <PageHero title={teamPage.heading} />
  <div class="mx-auto grid w-[90%] gap-16 py-14 min-[981px]:gap-20 min-[981px]:py-20">
    {
      groups.map((group) => (
        <section class="grid gap-10">
          <h2 class="text-[36px] leading-tight text-[#333] min-[981px]:text-[48px]">
            {group.heading}
          </h2>
          <div class="grid gap-x-[60px] gap-y-12 min-[981px]:grid-cols-3">
            {team
              .filter((person) => person.group === group.id)
              .sort((a, b) => a.order - b.order)
              .map((person: TeamMember) => {
                const [lead, ...rest] = bioParagraphs(person.bio);
                return (
                  <article class="grid content-start gap-4">
                    <div class="flex items-center gap-4">
                      <img
                        src={person.photo}
                        alt=""
                        class="h-[150px] w-[150px] shrink-0 rounded-full object-cover"
                      />
                      <div>
                        <h3 class="text-[24px] leading-tight text-[#333]">{person.name}</h3>
                        <p class="mt-1 text-[16px] leading-snug text-ink">{person.title}</p>
                      </div>
                    </div>
                    {(lead || rest.length > 0) && (
                      <div class="grid gap-4 px-[15px]">
                        {lead && <p class="text-[15.8px] leading-[1.52] text-ink">{lead}</p>}
                        {rest.length > 0 && (
                          <details class="bio-details group">
                            <summary class="bio-toggle cursor-pointer text-left text-[14px] uppercase tracking-[0.12em] text-accent">
                              <span class="group-open:hidden">+ Read more</span>
                              <span class="hidden group-open:inline">– Read less</span>
                            </summary>
                            <div class="mt-3 grid gap-3 text-[15.8px] leading-[1.52] text-ink">
                              {rest.map((paragraph) => (
                                <p>{paragraph}</p>
                              ))}
                            </div>
                          </details>
                        )}
                      </div>
                    )}
                  </article>
                );
              })}
          </div>
        </section>
      ))
    }
  </div>
</Base>
