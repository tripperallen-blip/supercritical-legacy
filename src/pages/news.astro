---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { formatDate, loadCoverage, loadMedia, loadPages, mediaImage, toDate } from '../lib/content';

const { news: newsPage } = loadPages();
const releases = (await getCollection('news'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const coverage = loadCoverage().slice(0, 4);
const media = loadMedia().slice(0, 3);

const eyebrow = 'mb-3 text-[11px] font-bold uppercase tracking-[0.18em] text-accent';
const title = 'fw-700 mb-12 text-[36px] leading-tight min-[981px]:mb-16 min-[981px]:text-[44px]';
---

<Base title={newsPage.title} section="news">
  <PageHero title={newsPage.heading} />

  <section class="bg-[#F5F5F7]">
    <div class="mx-auto w-[90%] py-16 min-[981px]:py-28">
      <p class="mb-3 text-[11px] font-bold uppercase tracking-[0.18em] text-ink-strong">Newsroom</p>
      <h2 class={`${title} text-ink-strong`}>Press Releases</h2>
      <div class="grid grid-cols-1 gap-6 min-[981px]:grid-cols-3">
        {
          releases.map((post) => (
            <article class="flex h-full flex-col border border-ink-strong/25 p-8 transition-[border-color,transform] duration-200 ease-out hover:-translate-y-1 hover:border-ink-strong">
              <p class="text-[11px] font-bold uppercase tracking-[0.16em] text-ink">{formatDate(post.data.date)}</p>
              <h3 class="fw-700 mt-4 text-[24px] leading-snug text-ink-strong">{post.data.title}</h3>
              <a href={`/${post.id}/`} class="mt-auto pt-8 text-[15px] font-bold text-ink-strong transition-colors duration-200 ease-out hover:text-black">
                Read more →
              </a>
            </article>
          ))
        }
      </div>
      <p class="mt-12">
        <a href="/press-releases/" class="text-[16px] font-bold text-ink-strong transition-colors duration-200 ease-out hover:text-black">All Press Releases</a>
      </p>
    </div>
  </section>

  {
    coverage.length > 0 && (
      <section class="bg-white">
        <div class="mx-auto w-[90%] py-16 min-[981px]:py-28">
          <p class={eyebrow}>Coverage</p>
          <h2 class={`${title} text-ink-strong`}>In the News</h2>
          <div class="grid grid-cols-1 gap-6 min-[700px]:grid-cols-2 min-[981px]:grid-cols-4">
            {coverage.map((item) => (
              <a
                href={item.url}
                target="_blank"
                rel="noopener noreferrer"
                class="flex h-full flex-col border border-[#e6e6e6] p-6 transition-colors duration-200 ease-out hover:border-accent/50"
              >
                <div class="mb-6 flex h-20 items-center justify-center border border-[#e6e6e6] px-4">
                  {item.logo ? (
                    <img src={item.logo} alt={item.outlet} class="max-h-12 w-auto max-w-full object-contain" />
                  ) : (
                    <span class="fw-700 text-center text-[16px] leading-tight text-ink-strong">{item.outlet}</span>
                  )}
                </div>
                <h3 class="fw-700 text-[18px] leading-snug text-black">{item.title}</h3>
                <p class="mt-auto pt-5 text-[13px] font-bold uppercase tracking-[0.12em] text-ink">{formatDate(toDate(item.date))}</p>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    media.length > 0 && (
      <section class="bg-[#F5F5F7]">
        <div class="mx-auto w-[90%] py-16 min-[981px]:py-28">
          <p class="mb-3 text-[11px] font-bold uppercase tracking-[0.18em] text-ink-strong">Media</p>
          <h2 class={`${title} text-ink-strong`}>Video & Podcasts</h2>
          <div class="grid grid-cols-1 gap-8 min-[981px]:grid-cols-3">
            {media.map((item) => {
              const image = mediaImage(item);
              return (
                <a href={item.url} target="_blank" rel="noopener noreferrer" class="group block">
                  <div class="relative aspect-video overflow-hidden bg-black">
                    {image && (
                      <img
                        src={image}
                        alt=""
                        class="h-full w-full object-cover brightness-75 transition duration-300 ease-out group-hover:scale-[1.03] group-hover:brightness-100"
                      />
                    )}
                    {item.type === 'video' && (
                      <span class="pointer-events-none absolute left-1/2 top-1/2 flex h-11 w-11 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-white text-ink-strong">
                        <svg viewBox="0 0 24 24" fill="currentColor" class="ml-0.5 h-4 w-4" aria-hidden="true">
                          <path d="M8 5.14v13.72a1 1 0 0 0 1.5.86l11-6.86a1 1 0 0 0 0-1.72l-11-6.86A1 1 0 0 0 8 5.14Z" />
                        </svg>
                      </span>
                    )}
                  </div>
                  <h3 class="fw-700 mt-4 text-[18px] leading-snug text-ink-strong transition-colors duration-200 ease-out group-hover:text-black">{item.title}</h3>
                  <p class="mt-1 text-[14px] leading-[1.4] text-ink">{item.show}</p>
                </a>
              );
            })}
          </div>
        </div>
      </section>
    )
  }
</Base>
