---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { formatDate, loadPages, subtitlesOf } from '../lib/content';

const { newsPage } = loadPages();
const posts = (await getCollection('news')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const featured = posts.filter((post) => post.data.featured);
const rest = posts.filter((post) => !post.data.featured);
---

<Base title={newsPage.title} section="news">
  <div class="mx-auto grid max-w-3xl gap-10 px-4 py-12">
    <h1 class="text-4xl">{newsPage.title}</h1>
    {
      featured.length > 0 && (
        <section class="grid gap-8">
          <h2 class="text-2xl">{newsPage.featuredHeading}</h2>
          {featured.map((post) => (
            <article class="grid gap-2">
              <h3 class="text-xl">
                <a href={`/${post.id}/`} class="underline">
                  {post.data.title}
                </a>
              </h3>
              {subtitlesOf(post.data).map((subtitle) => (
                <p>{subtitle}</p>
              ))}
              <p class="text-sm text-neutral-600">{formatDate(post.data.date)}</p>
            </article>
          ))}
        </section>
      )
    }
    {
      rest.length > 0 && (
        <section class="grid gap-8">
          <h2 class="text-2xl">More news</h2>
          {rest.map((post) => (
            <article class="grid gap-2">
              <h3 class="text-xl">
                <a href={`/${post.id}/`} class="underline">
                  {post.data.title}
                </a>
              </h3>
              <p class="text-sm text-neutral-600">{formatDate(post.data.date)}</p>
            </article>
          ))}
        </section>
      )
    }
  </div>
</Base>
