---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { formatDate, loadPages } from '../lib/content';

const { news: newsPage } = loadPages();
const posts = (await getCollection('news')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const featured = posts.filter((post) => post.data.featured);
const rest = posts.filter((post) => !post.data.featured);
---

<Base title={newsPage.title} section="news">
  <PageHero title={newsPage.heading} />
  <div class="mx-auto grid w-[90%] gap-12 py-14 min-[981px]:py-20">
    {
      featured.length > 0 && (
        <section>
          <h2 class="fw-700 mb-8 text-[36px] leading-tight text-ink-strong min-[981px]:text-[44px]">
            {newsPage.featuredHeading}
          </h2>
          {featured.map((post) => (
            <article class="mb-[50px]">
              <h3 class="fw-700 mb-[9px] text-[22px] leading-[1.4]">
                <a href={`/${post.id}/`} class="text-black hover:text-accent">
                  {post.data.title}
                </a>
              </h3>
              <p class="text-[15px] font-bold leading-[1.4] text-ink">{formatDate(post.data.date)}</p>
            </article>
          ))}
        </section>
      )
    }
    {
      rest.length > 0 && (
        <section>
          <h2 class="fw-700 mb-8 text-[36px] leading-tight text-ink-strong min-[981px]:text-[44px]">
            More news
          </h2>
          {rest.map((post) => (
            <article class="mb-[50px]">
              <h3 class="fw-700 mb-[9px] text-[22px] leading-[1.4]">
                <a href={`/${post.id}/`} class="text-black hover:text-accent">
                  {post.data.title}
                </a>
              </h3>
              <p class="text-[15px] font-bold leading-[1.4] text-ink">{formatDate(post.data.date)}</p>
            </article>
          ))}
        </section>
      )
    }
  </div>
</Base>
