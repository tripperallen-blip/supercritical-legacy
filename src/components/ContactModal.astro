---
import ContactForm from './ContactForm.astro';
---

<dialog data-contact-modal class="w-[min(32rem,calc(100%-2rem))] border border-neutral-300 p-0">
  <div class="grid gap-4 p-6">
    <div class="flex items-start justify-between gap-4">
      <h2 class="text-xl">Contact</h2>
      <button type="button" data-close-contact class="text-sm underline">
        Close
      </button>
    </div>
    <ContactForm idPrefix="modal" />
  </div>
</dialog>

<script>
  const dialog = document.querySelector('[data-contact-modal]');
  if (dialog instanceof HTMLDialogElement) {
    document.querySelectorAll('[data-open-contact]').forEach((button) => {
      button.addEventListener('click', () => dialog.showModal());
    });
    dialog.querySelector('[data-close-contact]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  }
</script>
