---
import { loadPages } from '../lib/content';

interface Props {
  idPrefix?: string;
}

const { idPrefix = 'contact' } = Astro.props;
const { site } = loadPages();
const [nameLabel, emailLabel, messageLabel] = site.contactModal.fields;
---

<form
  class="relative grid gap-4"
  name="contact"
  method="POST"
  action="/"
  data-netlify="true"
  netlify-honeypot="bot-field"
  data-contact-form
>
  <input type="hidden" name="form-name" value="contact" />
  <p class="honeypot" aria-hidden="true">
    <label>
      Don’t fill this out if you're human
      <input name="bot-field" tabindex="-1" autocomplete="off" />
    </label>
  </p>
  <div class="grid gap-4 min-[600px]:grid-cols-2">
    <label class="grid gap-1 text-[16px]" for={`${idPrefix}-name`}>
      <span class="sr-only">{nameLabel}</span>
      <input
        id={`${idPrefix}-name`}
        name="name"
        type="text"
        required
        autocomplete="name"
        placeholder={nameLabel}
        class="w-full bg-[#eee] px-4 py-4 text-[16px] text-ink-strong placeholder:text-[#999]"
      />
    </label>
    <label class="grid gap-1 text-[16px]" for={`${idPrefix}-email`}>
      <span class="sr-only">{emailLabel}</span>
      <input
        id={`${idPrefix}-email`}
        name="email"
        type="email"
        required
        autocomplete="email"
        placeholder={emailLabel}
        class="w-full bg-[#eee] px-4 py-4 text-[16px] text-ink-strong placeholder:text-[#999]"
      />
    </label>
  </div>
  <label class="grid gap-1 text-[16px]" for={`${idPrefix}-message`}>
    <span class="sr-only">{messageLabel}</span>
    <textarea
      id={`${idPrefix}-message`}
      name="message"
      required
      rows="6"
      placeholder={messageLabel}
      class="w-full bg-[#eee] px-4 py-4 text-[16px] text-ink-strong placeholder:text-[#999]"
    ></textarea>
  </label>
  <button type="submit" class="btn btn-dark w-fit">
    {site.contactModal.submit}
  </button>
  <p data-success hidden class="text-sm">
    Thank you. We’ve received your message and will get back to you soon.
  </p>
  <p data-error hidden class="text-sm">
    Something went wrong sending your message. Please try again.
  </p>
</form>

<script>
  document.querySelectorAll('[data-contact-form]').forEach((form) => {
    if (!(form instanceof HTMLFormElement) || form.dataset.bound === 'true') return;
    form.dataset.bound = 'true';
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const success = form.querySelector('[data-success]');
      const error = form.querySelector('[data-error]');
      success?.setAttribute('hidden', '');
      error?.setAttribute('hidden', '');
      const body = new URLSearchParams();
      new FormData(form).forEach((value, key) => {
        if (typeof value === 'string') body.append(key, value);
      });
      try {
        const response = await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: body.toString(),
        });
        if (!response.ok) throw new Error('Request failed');
        form.reset();
        success?.removeAttribute('hidden');
      } catch {
        error?.removeAttribute('hidden');
      }
    });
  });
</script>
