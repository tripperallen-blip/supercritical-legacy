---
import MobileMenu from './MobileMenu.astro';
import type { NavItem } from '../lib/content';

interface Props {
  nav: NavItem[];
  section?: string;
  overlay?: boolean;
}

const { nav, section = '', overlay = false } = Astro.props;
const current = Astro.url.pathname;

function isActive(item: NavItem) {
  if (current === item.href) return true;
  if (section === 'news' && item.href === '/newsroom/') return true;
  if (section === 'team' && item.href === '/our-team/') return true;
  if (section === 'technology' && item.href === '/technology/') return true;
  if (section === 'contact' && item.href === '/contact-us/') return true;
  return false;
}
---

<header
  data-site-header
  data-overlay={overlay ? 'true' : 'false'}
  class="fixed inset-x-0 top-0 z-40 transition-[background-color,height,color] duration-300"
>
  <div class="mx-auto flex h-full w-[90%] items-center justify-between">
    <a href="/" class="shrink-0">
      <img
        src="/assets/brand/SCT-Logo-Horizontal-1000.webp"
        alt="SuperCritical Materials"
        class="logo-color h-[45px] w-auto"
      />
      <img
        src="/assets/brand/SCT-Logo-Horizontal-500-white.webp"
        alt=""
        class="logo-white h-[45px] w-auto"
      />
    </a>
    <nav class="hidden items-center min-[981px]:flex" aria-label="Primary">
      {
        nav.map((item) => (
          <a href={item.href} aria-current={isActive(item) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>
    <MobileMenu nav={nav} current={current} section={section} />
  </div>
</header>

<script>
  const header = document.querySelector('[data-site-header]');
  if (header instanceof HTMLElement && header.dataset.overlay === 'true') {
    const sync = () => header.classList.toggle('is-solid', window.scrollY > 24);
    sync();
    window.addEventListener('scroll', sync, { passive: true });
  }
</script>
