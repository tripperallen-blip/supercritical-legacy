---
import MobileMenu from './MobileMenu.astro';
import type { NavItem } from '../lib/content';

interface Props {
  nav: NavItem[];
  section?: string;
}

const { nav, section = '' } = Astro.props;
const current = Astro.url.pathname;

function isActive(item: NavItem) {
  if (current === item.href) return true;
  if (section === 'news' && item.href === '/news/') return true;
  if (section === 'team' && item.href === '/our-team/') return true;
  if (section === 'technology' && item.href === '/technology/') return true;
  if (section === 'contact' && item.href === '/contact-us/') return true;
  return false;
}
---

<header data-site-header class="relative border-b border-neutral-200 bg-white">
  <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-3">
    <a href="/" class="shrink-0">
      <img src="/assets/brand/SCT-Logo-Horizontal-1000.webp" alt="SuperCritical Materials" class="h-10 w-auto" />
    </a>
    <nav class="hidden items-center gap-6 md:flex" aria-label="Primary">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item) ? 'page' : undefined}
            class:list={['text-sm', isActive(item) && 'underline']}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <MobileMenu nav={nav} current={current} section={section} />
  </div>
</header>
